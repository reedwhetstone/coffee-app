{
	"name": "coffee-app",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": "22.x"
	},
	"type": "module",
	"scripts": {
		"sync": "svelte-kit sync",
		"dev": "vite dev",
		"build": "pnpm verify:image-artifacts && pnpm run sync && vite build && pnpm verify:market-brief-artifact",
		"verify:image-artifacts": "node scripts/verify-image-artifacts.mjs",
		"vercel:ignore-build": "node scripts/vercel-ignore-build-step.mjs",
		"verify:market-brief-artifact": "node scripts/verify-market-brief-artifact.mjs",
		"build:analyze": "pnpm run build && vite-bundle-analyzer dist/",
		"preview": "vite preview",
		"audit:discoverability": "tsx scripts/audit-public-discoverability.ts",
		"verify:catalog-http-contract": "tsx scripts/verify-catalog-http-contract.ts",
		"verify:migration-authority": "node scripts/verify-migration-authority.mjs",
		"env:check": "node scripts/check-env-contract.mjs check",
		"env:check:e2e": "node scripts/check-env-contract.mjs e2e",
		"worktree:bootstrap": "bash scripts/bootstrap-worktree-env.sh",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "pnpm exec playwright test",
		"test:e2e:ui": "pnpm exec playwright test --ui",
		"test:e2e:report": "pnpm exec playwright show-report",
		"test:e2e:auth": "pnpm exec playwright test --project=setup",
		"test:codegen": "pnpm exec playwright codegen http://localhost:5173",
		"test:codegen:auth": "pnpm exec playwright codegen --load-storage=tests/e2e/.auth/user.json http://localhost:5173",
		"vercel-dev": "vercel dev"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.3",
		"@playwright/test": "^1.58.1",
		"@sveltejs/adapter-vercel": "^5.6.3",
		"@sveltejs/kit": "^2.17.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/d3": "^7.4.3",
		"@types/node": "^22.10.5",
		"@types/sanitize-html": "2.16.1",
		"autoprefixer": "^10.4.20",
		"bufferutil": "^4.0.9",
		"dotenv": "^16.6.1",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"glob": "^10.3.10",
		"globals": "^15.0.0",
		"happy-dom": "^20.7.0",
		"mdsvex": "^0.11.2",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.5",
		"tailwindcss": "^3.4.9",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.0.0",
		"utf-8-validate": "^6.0.5",
		"vite": "^5.1.0",
		"vite-bundle-analyzer": "^0.23.0",
		"vitest": "^2.0.4"
	},
	"dependencies": {
		"@ai-sdk/svelte": "^4.0.0",
		"@fontsource-variable/newsreader": "^5.2.10",
		"@humanspeak/svelte-markdown": "^0.8.10",
		"@purveyors/sdk": "0.40.0",
		"@supabase/ssr": "^0.5.2",
		"@supabase/supabase-js": "^2.99.1",
		"@vercel/analytics": "^1.4.1",
		"@vercel/speed-insights": "^1.2.0",
		"ai": "^6.0.0",
		"d3": "^7.9.0",
		"entities": "7.0.1",
		"fflate": "^0.8.3",
		"github-slugger": "^2.0.0",
		"jose": "^5.9.6",
		"layercake": "^10.0.2",
		"maplibre-gl": "6.6.0",
		"marked": "17.0.1",
		"sanitize-html": "2.17.7",
		"zod": "^4.0.17"
	}
}
